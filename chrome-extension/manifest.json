{
  "manifest_version": 3,
  "name": "ListSync",
  "version": "3.2",
  "description": "Automatisch auf Vinted, Kleinanzeigen & eBay posten + Vinted-Historie synchronisieren",
  "permissions": ["tabs", "scripting", "storage", "activeTab", "notifications", "windows"],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://project-dle5b.vercel.app/*",
    "https://www.vinted.de/*",
    "https://*.vinted.net/*",
    "https://www.kleinanzeigen.de/*",
    "https://www.ebay.de/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:3000/*", "https://project-dle5b.vercel.app/*"],
      "js": ["content/listsync-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.vinted.de/items/new*"],
      "js": ["content/vinted.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.vinted.de/items/*"],
      "js": ["content/vinted-import.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.vinted.de/",
        "https://www.vinted.de/?*",
        "https://www.vinted.de/catalog*",
        "https://www.vinted.de/member*",
        "https://www.vinted.de/my_orders*",
        "https://www.vinted.de/member/*"
      ],
      "js": ["content/vinted-sync.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.kleinanzeigen.de/anzeige-aufgeben*",
        "https://www.kleinanzeigen.de/p-anzeige-aufgeben*",
        "https://www.kleinanzeigen.de/anzeige/aufgeben*",
        "https://www.kleinanzeigen.de/m-anzeige-aufgeben*"
      ],
      "js": ["content/kleinanzeigen.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.ebay.de/sl/list*",
        "https://www.ebay.de/sl/*",
        "https://www.ebay.de/lstng*"
      ],
      "js": ["content/ebay.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
